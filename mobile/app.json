{
  "expo": {
    "name": "Pointage terrain",
    "slug": "edm-pointage-terrain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ml.edm.pointage.terrain",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à photographier les agents pour leur enrôlement et le pointage de secours.",
        "NSLocalNetworkUsageDescription": "Connexion au serveur central de pointage sur le réseau de l’entreprise."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à photographier les agents pour leur enrôlement et le pointage de secours."
        }
      ]
    ],
    "scheme": "edmterrain",
    "experiments": {
      "typedRoutes": false
    }
  }
}
