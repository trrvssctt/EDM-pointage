# Copier en server/.env (setup.sh le génère automatiquement avec des clés aléatoires).
# Clé de signature des sessions (JWT) : chaîne aléatoire d'au moins 32 caractères.
EDM_CLE_JWT=remplacer-par-une-cle-aleatoire
# Clé Fernet de chiffrement des gabarits biométriques et des secrets 2FA.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATTENTION : la perdre rend les gabarits illisibles (il faudrait ré-enrôler tous les agents).
EDM_CLE_BIOMETRIE=remplacer-par-une-cle-fernet
# Base de données : SQLite par défaut ; PostgreSQL recommandé en production.
# EDM_DATABASE_URL=postgresql+psycopg://edm:motdepasse@localhost:5432/edm_pointage
# Durée d'une session (minutes) sans « Rester connecté » (30 jours sinon).
# EDM_DUREE_JETON_MINUTES=480
# Seuil de reconnaissance faciale (similarité cosinus SFace, 0,363 recommandé par OpenCV).
# EDM_SEUIL_SIMILARITE=0.42
# Exiger la preuve de vivacité (rotation de la tête) lors de l'enrôlement : 1 (défaut) ou 0.
# EDM_ENROLEMENT_VIVACITE_OBLIGATOIRE=1
